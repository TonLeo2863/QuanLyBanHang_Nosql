@model QuanLyBanHang.Models.Delivery

@{
    ViewBag.Title = "Sửa giao hàng";
}

<h2>Sửa giao hàng</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m._id)

    @Html.HiddenFor(m => m._rev)

    <div class="form-group">
        <label>Mã giao hàng</label>

        @Html.TextBoxFor(
            m => m._id,
            new
            {
                @class = "form-control",
                @readonly = "readonly"
            }
        )
    </div>

    <div class="form-group">
        <label>Mã đơn hàng</label>

        @Html.TextBoxFor(
            m => m.orderId,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Mã shipper</label>

        @Html.TextBoxFor(
            m => m.shipperId,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Tên shipper</label>

        @Html.TextBoxFor(
            m => m.shipperName,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Số điện thoại</label>

        @Html.TextBoxFor(
            m => m.shipperPhone,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Trạng thái</label>

        @Html.DropDownListFor(
            m => m.status,
            new SelectList(
                new[]
                {
                    "pending", "assigned", "failed",
                    "shipping",
                    "delivered",
                    "cancelled"
                },
                Model.status
            ),
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Ngày lấy hàng</label>

        @Html.TextBoxFor(
            m => m.pickupDate,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Ngày dự kiến giao</label>

        @Html.TextBoxFor(
            m => m.expectedDate,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <div class="form-group">
        <label>Địa chỉ</label>

        @Html.TextBoxFor(
            m => m.address,
            new
            {
                @class = "form-control"
            }
        )
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Lưu thay đổi
    </button>

    @Html.ActionLink(
        "Quay lại",
        "Index",
        "Delivery",
        null,
        new
        {
            @class = "btn btn-secondary"
        }
    )
}
