<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Quản lý bán hàng</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <nav class="navbar navbar-inverse">
        <div class="container">

            <div class="navbar-header">

                <button type="button"
                        class="navbar-toggle collapsed"
                        data-toggle="collapse"
                        data-target="#mainMenu">

                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>

                </button>

                @Html.ActionLink(
                    "QUẢN LÝ BÁN HÀNG",
                    "Index",
                    "Home",
                    null,
                    new { @class = "navbar-brand" }
                )

            </div>

            <div id="mainMenu" class="collapse navbar-collapse">

                <ul class="nav navbar-nav">

                    <li>
                        @Html.ActionLink(
                            "Trang chủ",
                            "Index",
                            "Home"
                        )
                    </li>

                    <li>
                        @Html.ActionLink(
                            "Khách hàng",
                            "Index",
                            "Customer"
                        )
                    </li>

                    <li>
                        @Html.ActionLink(
                            "Sản phẩm",
                            "Index",
                            "Product"
                        )
                    </li>

                    <li>
                        @Html.ActionLink(
                            "Đơn hàng",
                            "Index",
                            "Order"
                        )
                    </li>

                    <li>
                        @Html.ActionLink(
                            "Giao hàng",
                            "Index",
                            "Delivery"
                        )
                    </li>

                </ul>

            </div>

        </div>
    </nav>


    <main class="container body-content">

        @if (ViewBag.Error != null || TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@(ViewBag.Error ?? TempData["Error"])</div>
        }
        @if (Request.IsAuthenticated) {
            <p>@User.Identity.Name | @Html.ActionLink("Người dùng", "Users", "Account") | @Html.ActionLink("Đồng bộ", "Index", "Sync")</p>
            using (Html.BeginForm("Logout", "Account", FormMethod.Post)) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-link">Đăng xuất</button> }
        }
        @RenderBody()

        <hr />

        <footer>
            <p>
                &copy; @DateTime.Now.Year - Quản lý bán hàng
            </p>
        </footer>

    </main>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>
