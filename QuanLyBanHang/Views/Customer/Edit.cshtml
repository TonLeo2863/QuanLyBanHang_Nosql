@model QuanLyBanHang.Models.Customer

@{
    ViewBag.Title = "Sửa khách hàng";
}

<h2>Sửa khách hàng</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(
        m => m._rev
    )

    <div class="form-group">
        <label>Mã khách hàng</label>

        @Html.TextBoxFor(
            m => m._id,
            new
            {
                @class = "form-control",
                @readonly = "readonly"
            }
        )
    </div>

    <div class="form-group">
        <label>Họ tên</label>

        @Html.TextBoxFor(
            m => m.name,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Số điện thoại</label>

        @Html.TextBoxFor(
            m => m.phone,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Email</label>

        @Html.TextBoxFor(
            m => m.email,
            new { @class = "form-control" }
        )
    </div>

    <div class="form-group">
        <label>Địa chỉ</label>

        @Html.TextBoxFor(
            m => m.address,
            new { @class = "form-control" }
        )
    </div>

    <br />

    <button type="submit"
            class="btn btn-warning">
        Lưu thay đổi
    </button>

    @Html.ActionLink(
        "Quay lại",
        "Index",
        "Customer",
        null,
        new { @class = "btn btn-secondary" }
    )
}